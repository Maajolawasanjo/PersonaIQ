# PersonaIQ Backend API Environment Configuration Template
APP_NAME=PersonaIQ
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5432/personaiq
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security & Authentication
JWT_SECRET_KEY=YOUR_64_CHAR_HEX_JWT_SECRET_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# AI Provider Credentials
FEATHERLESS_API_KEY=YOUR_FEATHERLESS_API_KEY
YOUCAM_API_KEY=YOUR_YOUCAM_API_KEY
YOUCAM_BASE_URL=https://api.perfectcorp.com/v1

# Storage (Supabase)
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=personaiq-uploads

# Email Dispatch (SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=YOUR_RESEND_API_KEY
EMAILS_FROM_EMAIL=no-reply@personaiq.com
EMAILS_FROM_NAME=PersonaIQ Team

# CORS
CORS_ORIGINS=["https://personaiq-web.vercel.app","http://localhost:3000"]
