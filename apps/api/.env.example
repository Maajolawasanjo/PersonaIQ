# Application Identity
APP_NAME="PersonaIQ Backend API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000

# Security & Authentication
SECRET_KEY="change-this-to-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Async PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/personaiq"

# AI Provider Configurations
FEATHERLESS_API_KEY=""
FEATHERLESS_BASE_URL="https://api.featherless.ai/v1"
FEATHERLESS_DEFAULT_MODEL="meta-llama/Meta-Llama-3.1-70B-Instruct"

YOUCAM_API_KEY=""
YOUCAM_BASE_URL="https://api.perfectcorp.com/v1"

# Storage Configuration
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Feature Flags
ENABLE_YOUCAM_VTO=true
ENABLE_SKIN_ANALYSIS=true
ENABLE_PDF_EXPORT=true
ENABLE_EMAIL_NOTIFICATIONS=true

# Email SMTP Configuration (Gmail / Custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="your-email@gmail.com"
EMAILS_FROM_NAME="PersonaIQ Executive"
