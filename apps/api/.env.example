# ============================================================
# PersonaIQ Backend API — Environment Configuration Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application Identity ─────────────────────────────────────
APP_NAME="PersonaIQ Backend API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"           # development | staging | production
DEBUG=true                          # Set false in production

# ── Server ───────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000

# ── Security & Authentication ─────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY="change-this-to-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (Supabase / PostgreSQL) ──────────────────────────
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/personaiq"
DIRECT_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/personaiq"

# ── AI Provider: Featherless ──────────────────────────────────
FEATHERLESS_API_KEY=""
FEATHERLESS_BASE_URL="https://api.featherless.ai/v1"
FEATHERLESS_DEFAULT_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# ── AI Provider: YouCam (Perfect Corp) ───────────────────────
YOUCAM_API_KEY=""
YOUCAM_SECRET_KEY=""
YOUCAM_BASE_URL="https://api.perfectcorp.com/v1"

# ── Supabase Storage ─────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# ── Feature Flags ─────────────────────────────────────────────
ENABLE_YOUCAM_VTO=true
ENABLE_SKIN_ANALYSIS=true
ENABLE_PDF_EXPORT=true
ENABLE_EMAIL_NOTIFICATIONS=true     # Set false to suppress all emails (e.g. CI)

# ── Email SMTP (Gmail App Password recommended) ───────────────
# For Gmail: enable 2FA on Google account, generate an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-gmail@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"    # 16-char Gmail App Password (with spaces is fine)
EMAILS_FROM_EMAIL="your-gmail@gmail.com"
EMAILS_FROM_NAME="PersonaIQ"

# ── Email: Dev/Test ───────────────────────────────────────────
# Used by POST /api/v1/auth/test-email to send real previews to your inbox.
# Set to your own email address to receive all 27 template previews.
EMAIL_TEST_RECIPIENT="your-inbox@gmail.com"
# Embedded in account-deleted and two-factor-code email templates
EMAIL_SUPPORT_URL="https://personaiq.com/support"
