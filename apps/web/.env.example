# PersonaIQ Web Frontend Environment Configuration Template
NEXT_PUBLIC_API_BASE_URL=https://api.personaiq.com/api/v1
NEXT_PUBLIC_APP_URL=https://personaiq-web.vercel.app

# Supabase Auth Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Next.js Build Options
NEXT_TELEMETRY_DISABLED=1
